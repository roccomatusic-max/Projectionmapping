# ---------------------------------------------------------------------------
# Projector Control — environment configuration
#
# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Secrets (required) ----------------------------------------------------

# Signs session tokens AND derives the key that encrypts stored projector
# passwords. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# IMPORTANT: changing this invalidates all logins and makes stored projector
# passwords unreadable — you would have to re-enter each one. Back it up with
# the database.
SECRET_KEY=

# PostgreSQL password. Generate one; do not reuse a password from elsewhere.
POSTGRES_PASSWORD=
POSTGRES_USER=projector
POSTGRES_DB=projector

# --- First run -------------------------------------------------------------

# The initial administrator. If the password is left blank, a random one is
# generated and printed to the container log exactly once:
#   docker compose logs api | grep -A4 "initial administrator"
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Network binding -------------------------------------------------------

# Which host interface the web UI is published on. Default 127.0.0.1 means
# "this machine only" — set it to your LAN or VPN address to reach it from
# other devices. Do NOT set 0.0.0.0 unless you understand every interface the
# host has. This application must never be exposed directly to the internet;
# use a VPN (see docs/DEPLOYMENT.md).
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8000

ENVIRONMENT=production
DEBUG=false

# Origins allowed to call the API from a browser. Only needed when running
# the frontend dev server separately; the production image serves the UI from
# the same origin, so this can stay as-is.
CORS_ORIGINS=http://localhost:5173

# --- Polling intervals (seconds) -------------------------------------------
# Raise these if you have many projectors or a slow control network. Each
# projector can override them individually from its settings.

POLL_CONNECTIVITY=10
POLL_OPERATIONAL=15
POLL_DIAGNOSTICS=60
POLL_MAINTENANCE=300

# A projector is reported "stale" rather than "online" once this multiple of
# the operational interval passes without a successful poll.
STALENESS_MULTIPLIER=3.0

# --- Device communication --------------------------------------------------

COMMAND_TIMEOUT=5.0
CONNECT_TIMEOUT=3.0

# Minimum gap between commands to one projector. Panasonic's specification
# says to wait more than 0.5 s after a response before sending the next
# command; do not lower this below 0.6 without a reason.
PANASONIC_COMMAND_GAP=0.6
PJLINK_COMMAND_GAP=0.15

# After a power command, how long to wait between confirming QPW polls, and
# how many to attempt. 30 attempts x 2 s covers a 60 s warm-up.
POWER_VERIFY_DELAY=2.0
POWER_VERIFY_ATTEMPTS=30

# --- Alerting --------------------------------------------------------------

# Minutes before an unresolved alert notifies again.
ALERT_RENOTIFY_MINUTES=60

# Email alerts. Leave SMTP_HOST blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=projector-control@example.local
SMTP_TLS=true
# Comma-separated.
ALERT_EMAIL_TO=

# --- Integrations ----------------------------------------------------------

# MQTT publishing and Home Assistant discovery. Set WITH_MQTT=true as well so
# the image installs the MQTT client library.
WITH_MQTT=false
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PREFIX=projector
HOMEASSISTANT_DISCOVERY=true
HOMEASSISTANT_DISCOVERY_PREFIX=homeassistant

# --- Retention (days) ------------------------------------------------------

TELEMETRY_RETENTION_DAYS=365
COMMAND_LOG_RETENTION_DAYS=180
EVENT_RETENTION_DAYS=365
